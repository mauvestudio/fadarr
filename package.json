{
  "name": "fadarr",
  "version": "0.12.0",
  "description": "Prepare DJ sets in your browser: two decks streaming from your NAS, playlists, hot cues and loops, Traktor import, Rekordbox export.",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "build:analyzer": "sh analyzer/build.sh"
  },
  "license": "GPL-2.0-or-later",
  "private": true,
  "dependencies": {
    "express": "^4.22.3",
    "fast-xml-parser": "^5.11.2",
    "music-metadata": "^12.3.4"
  },
  "keywords": [
    "dj",
    "traktor",
    "rekordbox",
    "nml",
    "playlist",
    "cue",
    "self-hosted",
    "unraid"
  ],
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/mauvestudio/fadarr.git"
